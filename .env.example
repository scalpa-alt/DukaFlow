# Copy these into Vercel -> Project Settings -> Environment Variables.
# Never commit real values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the M-Pesa callback. Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Emails the shop join code to the owner (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=

# M-Pesa (Safaricom Daraja). Leave empty until you have the keys.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=production
# Optional. Defaults to https://<your-site>/api/public/mpesa/callback
MPESA_CALLBACK_URL=
# Optional shared secret. If set, the callback URL must end with ?token=<this value>
MPESA_CALLBACK_TOKEN=
