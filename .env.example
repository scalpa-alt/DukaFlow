# Copy these into Vercel -> Project Settings -> Environment Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only (M-Pesa callback writes payments with this). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Emails the shop join code to the owner (resend.com)
RESEND_API_KEY=
MAIL_FROM=
# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=production
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Only for running drizzle-kit locally
DATABASE_URL=
